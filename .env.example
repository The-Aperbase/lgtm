GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
GRAFANA_ROOT_URL=https://grafana.example.com
GRAFANA_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GRAFANA_GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GRAFANA_GOOGLE_ROLE_ATTRIBUTE_PATH=email == 'admin@example.com' && 'GrafanaAdmin' || email == 'viewer@example.com' && 'Viewer'
TELEMETRY_NETWORK=apesdb-telemetry
DOKPLOY_NETWORK=dokploy-network

# Break-glass overrides. The defaults retain basic login behind ?disableAutoLogin=true.
GRAFANA_GOOGLE_ENABLED=true
GRAFANA_GOOGLE_AUTO_LOGIN=true
GRAFANA_BASIC_AUTH_ENABLED=true
GRAFANA_DISABLE_LOGIN_FORM=false
