GRAFANA_DOMAIN=grafana.example.com
OTEL_DOMAIN=otel.example.com
OTEL_API_KEY=replace-with-a-random-api-key
GRAFANA_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GRAFANA_GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GRAFANA_ADMIN_PASSWORD=replace-with-a-random-fallback-password
GRAFANA_GOOGLE_ROLE_ATTRIBUTE_PATH="email == 'admin.one@example.com' && 'GrafanaAdmin' || email == 'admin.two@example.com' && 'GrafanaAdmin' || email == 'viewer@example.com' && 'Viewer'"

# Lockout-recovery overrides. Leave these values unchanged normally.
GRAFANA_BASIC_AUTH_ENABLED=false
GRAFANA_DISABLE_LOGIN_FORM=true
GRAFANA_GOOGLE_AUTO_LOGIN=true
