COMPOSE_FILE=compose.yml:docker-compose.yml

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-random-password
GRAFANA_DATABASE_PASSWORD=replace-with-a-different-local-random-password
GRAFANA_ROOT_URL=http://localhost:3000

# Compose currently requires these values even when Google login is disabled.
GRAFANA_GOOGLE_CLIENT_ID=unused-local
GRAFANA_GOOGLE_CLIENT_SECRET=unused-local
GRAFANA_GOOGLE_ADMIN_EMAIL_1=admin.one@example.com
GRAFANA_GOOGLE_ADMIN_EMAIL_2=admin.two@example.com

GRAFANA_GOOGLE_ENABLED=false
GRAFANA_GOOGLE_AUTO_LOGIN=false
GRAFANA_BASIC_AUTH_ENABLED=true
GRAFANA_DISABLE_LOGIN_FORM=false

TELEMETRY_NETWORK=apesdb-telemetry
